{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "NetSuite Capture Pro",
  "version": "0.4.0",
  "description": "Capture visible or vertically scrolling NetSuite records locally as PNG images.",
  "permissions": ["activeTab", "downloads", "scripting"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "NetSuite Capture Pro",
    "default_popup": "popup/popup.html"
  }
}
